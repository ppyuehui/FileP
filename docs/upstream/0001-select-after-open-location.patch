 src/app/app_runtime.cpp    |  2 +
 src/app/reveal_request.cpp | 86 ++++++++++++++++++++++++++++++++++++++
 src/app/reveal_request.h   | 26 ++++++++++++
 4 files changed, 117 insertions(+)
 create mode 100644 src/app/reveal_request.cpp
 create mode 100644 src/app/reveal_request.h

